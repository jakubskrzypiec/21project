# ─── Podstawy ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Publiczny adres, pod którym stoi panel (bez ukośnika na końcu)
PUBLIC_URL=https://panel.21project.pl
SITE_URL=https://21project.pl
TIMEZONE=Europe/Warsaw

# Domeny, z których przyjmuję zdarzenia licznika i zapytania z formularza
ALLOWED_ORIGINS=https://21project.pl,https://www.21project.pl

# ─── Logowanie do panelu ───────────────────────────────────────────────────
ADMIN_EMAIL=jakubskrzypiec.dev@gmail.com
# Hasło do panelu — wybierz JEDNO z dwóch:
#  a) gotowy hash (zalecane):  npm run set-password -- "twoje-haslo"
ADMIN_PASSWORD_HASH=
#  b) zwykły tekst — hash powstanie przy starcie (min. 10 znaków)
ADMIN_PASSWORD=
# Klucz sesji. Zostaw pusty, a wylosuje się sam i zapisze w bazie — ale wtedy
# panel wylogowuje przy każdym wdrożeniu, jeśli katalog DATA_DIR nie jest trwałym
# dyskiem. Na hostingu ustaw go tutaj na stałe: openssl rand -base64 48
JWT_SECRET=
# Sesja jest przesuwana — każdy dzień korzystania z panelu liczy ważność od nowa.
SESSION_TTL_DAYS=30
# Opcjonalnie: wpuszczaj do panelu tylko z tych adresów IP (po przecinku)
ADMIN_IP_ALLOWLIST=

# ─── Google (Gmail + Kalendarz) ────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://panel.21project.pl/api/google/callback
GOOGLE_CALENDAR_ID=primary

# ─── AI (pisanie wiadomości, streszczenia wątków) ──────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Szukanie leadów ───────────────────────────────────────────────────────
CRAWLER_USER_AGENT=21projectBot/1.0 (+https://21project.pl/kontakt.html)
CRAWLER_TIMEOUT_MS=12000
CRAWLER_DELAY_MS=1500
CRAWLER_RESPECT_ROBOTS=true
# Opcjonalne wyszukiwanie firm: Google Programmable Search Engine
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ─── Wysyłka do potencjalnych klientów ─────────────────────────────────────
# draft = tylko Kopie robocze w Gmailu | approve = wysyłasz ręcznie | auto = kolejka sama wysyła
OUTREACH_MODE=draft
OUTREACH_DAILY_LIMIT=20
OUTREACH_HOURLY_LIMIT=5
OUTREACH_WINDOW_START=9
OUTREACH_WINDOW_END=17
OUTREACH_WORKDAYS_ONLY=true
OUTREACH_FROM_NAME=Jakub Skrzypiec — 21 project
OUTREACH_SIGNATURE=
